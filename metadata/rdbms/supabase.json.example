{
  "rdbms": {
    "POSTGRESQL": {
      "sshTunnelUsePrivateKey": false,
      "databaseName": "${SUPABASE_DB}",
      "pluginId": "POSTGRESQL",
      "indexTablespace": "",
      "sshTunnelEnabled": false,
      "dataTablespace": "",
      "accessType": 0,
      "hostname": "${SUPABASE_HOST}",
      "password": "${SUPABASE_PASSWORD}",
      "pluginName": "PostgreSQL",
      "port": "${SUPABASE_PORT}",
      "servername": "",
      "attributes": {
        "SSL": "true",
        "SSLMODE": "${SUPABASE_SSLMODE}"
      },
      "username": "${SUPABASE_USER}"
    }
  },
  "name": "supabase"
}
