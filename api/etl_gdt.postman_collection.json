              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('co data + meta', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('data');",
              "  pm.expect(b.meta).to.have.property('total');",
