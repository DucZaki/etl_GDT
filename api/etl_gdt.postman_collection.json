            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Kiem tra API + ket noi DB. Khong can API key."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('database up', () => pm.expect(pm.response.json().database).to.eql('up'));"
            ]
          }
        }
      ]
