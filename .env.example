# =============================================================================
# .env.example - copy to .env and fill in. .env is gitignored.
# =============================================================================

# --- Apache Hop ---
HOP_HOME=C:/Users/minhd/apache-hop-2.20.0/hop
HOP_CONFIG_FOLDER=C:/Users/minhd/.hop/config
HOP_AUDIT_FOLDER=C:/Users/minhd/.hop/audit
HOP_OPTIONS=-Xmx2048m

# --- Google Drive (Hop VFS) ---
# Credentials file downloaded from Google Cloud Console (OAuth client, Desktop type)
GDRIVE_CREDENTIALS_FILE=C:/Users/minhd/.hop/gdrive/client_secret.json
GDRIVE_TOKENS_FOLDER=C:/Users/minhd/.hop/gdrive/tokens
GDRIVE_SOURCE_PATH=googledrive:///etl/sample_data_dirty.xlsx

# --- Supabase (session pooler, port 5432, sslmode=require) ---
SUPABASE_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.PROJECT_REF
SUPABASE_PASSWORD=CHANGE_ME
SUPABASE_SSLMODE=require

# --- Read API (Flask) ---
API_HOST=127.0.0.1
API_PORT=8000
# API_KEY=CHANGE_ME          # neu dat, client phai gui header X-API-Key

# --- ETL behaviour ---
ETL_BATCH_SIZE=1000
ETL_LOG_LEVEL=BASIC
ETL_SCHEDULE_MINUTES=15
DRIVE_WATCH_INTERVAL_SECONDS=300