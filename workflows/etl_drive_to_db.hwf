<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>etl_drive_to_db</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Read Google Drive xlsx, load staging, validate/clean, upsert to Supabase, log the run. Self-contained: creates staging and logging schemas first.</description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/11/05 14:40:00.000</created_date>
  <modified_date>2026/11/05 15:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>Y</repeat>
      <schedulerType>2</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>2</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql/>
      <connection>supabase</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/init/01_staging.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <sendOneStatement>Y</sendOneStatement>
      <name>Init staging schema</name>
      <description>Create staging tables and helper functions if they do not exist (sql/01_staging.sql).</description>
      <type>SQL</type>
      <attributes/>
      <xloc>280</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql/>
      <connection>supabase</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/init/03_logging.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <sendOneStatement>Y</sendOneStatement>
      <name>Init logging schema</name>
      <description>Create etl_run_log / etl_rejects if they do not exist (sql/03_logging.sql).</description>
      <type>SQL</type>
      <attributes/>
      <xloc>480</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/drive/02_drive_to_supabase.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Load staging from Drive</name>
      <description>Read the 3 Excel sheets and truncate/load stg_customers, stg_products, stg_orders.</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>700</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/cleaning/clean.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>N</insertScript>
      <script/>
      <name>Validate and upsert to DB (Python)</name>
      <description>Run cleaning/clean.py: dedupe, normalize, validate, then upsert into customers/products/orders.</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>920</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql/>
      <connection>supabase</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/init/06_security.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <sendOneStatement>Y</sendOneStatement>
      <name>Apply security</name>
      <description>Apply RLS, policies, indexes and FK constraints (sql/06_security.sql).</description>
      <type>SQL</type>
      <attributes/>
      <xloc>1030</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql/>
      <connection>supabase</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/steps/04_log_run.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <sendOneStatement>Y</sendOneStatement>
      <name>Log success</name>
      <description>Write a success row to etl_run_log (sql/04_log_run.sql).</description>
      <type>SQL</type>
      <attributes/>
      <xloc>1250</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1470</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql/>
      <connection>supabase</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/steps/05_log_failure.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <sendOneStatement>Y</sendOneStatement>
      <name>Log failure</name>
      <description>Write a failed row to etl_run_log (sql/05_log_failure.sql).</description>
      <type>SQL</type>
      <attributes/>
      <xloc>928</xloc>
      <yloc>336</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <name>Abort</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1344</xloc>
      <yloc>336</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init staging schema</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Init staging schema</from>
      <to>Init logging schema</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Init staging schema</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Init logging schema</from>
      <to>Load staging from Drive</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Init logging schema</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Load staging from Drive</from>
      <to>Validate and upsert to DB (Python)</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Load staging from Drive</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate and upsert to DB (Python)</from>
      <to>Apply security</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Apply security</from>
      <to>Log success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Apply security</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate and upsert to DB (Python)</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Log success</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Log success</from>
      <to>Log failure</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Log failure</from>
      <to>Abort</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
